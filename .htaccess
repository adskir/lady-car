# HTTPS + dominio senza www
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.lady-car\.it$ [NC]
RewriteRule ^ https://lady-car.it%{REQUEST_URI} [L,R=301]

# Non pubblicare file di servizio del repository
RewriteRule ^(\.git|\.github|scripts|README\.md) - [F,L]

# Cache per immagini e font
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>
